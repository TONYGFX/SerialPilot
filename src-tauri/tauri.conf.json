{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SerialPilot",
  "version": "0.1.1",
  "identifier": "com.serialpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "SerialPilot", "width": 1280, "height": 840, "minWidth": 960, "minHeight": 640, "backgroundColor": "#101518" }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
